# Dependencies — reinstalled inside the image via npm ci
node_modules

# TypeScript output — rebuilt inside the image via npm run build
dist

# Local env files — secrets must be injected at runtime, not baked into the image
.env
.env.*
!.env.example

# Test artefacts
*.log
*.sh
check_borrow_fine.py

# Editor / OS noise
.DS_Store
*.swp
.vscode

# Git
.git
.gitignore

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
