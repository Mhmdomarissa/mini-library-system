PORT=4000
# Local dev (requires a running mongod with --replSet rs0):
MONGODB_URI=mongodb://127.0.0.1:27017/mini-library?replicaSet=rs0
# Docker (use the compose service name as hostname):
# MONGODB_URI=mongodb://mongo:27017/mini-library?replicaSet=rs0

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Logging
LOG_LEVEL=info
BORROW_DURATION_DAYS=14
MAX_ACTIVE_BORROWS=5
FINE_PER_DAY=1

# OpenAI
OPENAI_API_KEY=your_key_here

# CORS — comma-separated list of allowed front-end origins
# Leave unset in local dev (all origins are allowed).
# MUST be set in production, e.g.:
# ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=
