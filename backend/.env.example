PORT=4000
NODE_ENV=development
# NODE_ENV=production  ← set this on Railway / Render (enables strict CORS + rate limiting)

# Local dev (requires a running mongod with --replSet rs0):
MONGODB_URI=mongodb://127.0.0.1:27017/mini-library?replicaSet=rs0
# Docker Compose (use the compose service name as hostname):
# MONGODB_URI=mongodb://mongo:27017/mini-library?replicaSet=rs0
# Production — MongoDB Atlas (NO replicaSet param, Atlas handles this internally):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mini-library?retryWrites=true&w=majority

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Logging
LOG_LEVEL=info
BORROW_DURATION_DAYS=14
MAX_ACTIVE_BORROWS=5
FINE_PER_DAY=1

# OpenAI
OPENAI_API_KEY=your_key_here

# CORS — comma-separated list of allowed front-end origins
# Leave unset in local dev (all origins are allowed).
# MUST be set in production, e.g.:
# ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=
